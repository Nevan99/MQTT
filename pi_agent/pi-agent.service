[Unit]
Description=Pi MQTT Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ats/MQTT/pi_agent
ExecStart=/home/ats/MQTT/.venv/bin/python /home/ats/MQTT/pi_agent/pi_agent.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
